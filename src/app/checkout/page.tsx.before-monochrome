'use client';
import {useEffect,useState} from 'react';import Link from 'next/link';
type Line={id:number;size:string;color:string;qty:number};
const input:React.CSSProperties={display:'block',padding:13,border:'1px solid #c8c2ba',background:'#fff',width:'100%',margin:'8px 0 17px'};
export default function Checkout(){const [cart,setCart]=useState<Line[]>([]),[form,setForm]=useState({recipient:'',address_line1:'',address_line2:'',city:'',state:'',postal_code:''}),[state,setState]=useState(''),[busy,setBusy]=useState(false),[order,setOrder]=useState('');
useEffect(()=>{try{setCart(JSON.parse(localStorage.getItem('dt-cart')||'[]'))}catch{}},[]);
async function submit(e:React.FormEvent){e.preventDefault();setBusy(true);setState('');try{const r=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...form,items:cart})});const j=await r.json();if(!r.ok)throw new Error(j.error||'Request failed');setOrder(j.order.order_number);localStorage.removeItem('dt-cart');setCart([])}catch(e){setState(e instanceof Error?e.message:'Unable to submit')}finally{setBusy(false)}}
return <main style={{background:'#f8f6f2',color:'#20201d',minHeight:'100vh',padding:'clamp(20px,5vw,64px)',fontFamily:'Arial,sans-serif'}}><Link href="/" style={{color:'inherit',letterSpacing:'.23em'}}>DRAGONTAIL</Link><div style={{maxWidth:650,margin:'64px auto'}}><small>DRAGONTAIL / CHECKOUT PREVIEW</small><h1 style={{font:'50px Georgia,serif'}}>Order request.</h1><p>Razorpay is not connected yet. This records your request but does not collect payment, reserve stock, or confirm shipment.</p>{order?<section><h2>Request received: {order}</h2><p>Payment status: Unpaid. You can track this request in your account.</p><Link href="/account/orders">VIEW MY ORDERS →</Link></section>:<form onSubmit={submit}><p>{cart.length} cart variant(s). Prices and availability will be validated on the server.</p>{Object.entries({recipient:'Recipient name',address_line1:'Address line 1',address_line2:'Address line 2 (optional)',city:'City',state:'State',postal_code:'PIN code'}).map(([key,label])=><label key={key}>{label}<input style={input} value={form[key as keyof typeof form]} required={key!=='address_line2'} onChange={e=>setForm(v=>({...v,[key]:e.target.value}))}/></label>)}<button disabled={busy||!cart.length} style={{padding:18,background:'#222',color:'#fff',border:0,cursor:'pointer',width:'100%'}}>{busy?'SAVING...':'SUBMIT UNPAID ORDER REQUEST'}</button><p role="status">{state}</p><p>Sign in to your customer account before submitting.</p></form>}</div></main>}
