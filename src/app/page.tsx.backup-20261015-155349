 {detail&&<div className="backdrop modal-backdrop" onMouseDown={()=>closeQuickView()}><section className="product-modal upgraded-product-modal" role="dialog" aria-modal="true" aria-label={`${detail.name} product details`} onMouseDown={e=>e.stopPropagation()}><button className="modal-close" aria-label="Close product" onClick={()=>closeQuickView()}><X/></button><div className="dt-gallery"><div className="dt-main-image" onPointerDown={e=>{e.currentTarget.dataset.startX=String(e.clientX)}} onPointerUp={e=>{const start=Number(e.currentTarget.dataset.startX);const diff=e.clientX-start;if(galleryImages.length>1&&Math.abs(diff)>55)moveGallery(diff<0?1:-1)}}><button className={'dt-zoom '+(zoomed?'is-zoomed':'')} aria-label={zoomed?'Zoom out':'Zoom in'} onClick={()=>setZoomed(v=>!v)}><img key={`${detail.id}-${selectedColor}-${galleryIndex}`} src={galleryImages[galleryIndex]||detail.image} loading="eager" decoding="async" alt={`${detail.name} – ${selectedColor} – photograph ${galleryIndex+1}`}/><span><ZoomIn size={16}/> {zoomed?'ZOOM OUT':'VIEW DETAIL'}</span></button></div><div className="dt-thumbs">{galleryImages.map((img,i)=><button key={i} aria-label={`Show product photograph ${i+1}`} aria-pressed={galleryIndex===i} className={galleryIndex===i?'active':''} onClick={()=>{setGalleryIndex(i);setZoomed(false)}}><img src={img} alt=""/></button>)}</div><small className="dt-gallery-note">Swipe or drag to browse photos.</small></div><div className="modal-info dt-product-info"><span className="eyebrow">DRAGONTAIL / {detail.category.toUpperCase()}</span><h2>{detail.name}</h2><strong className="modal-price">{money(detail.price)}</strong><p>{detail.description}</p><div className="modal-line"/><div className="dt-option-heading"><span className="option-label">COLOR — {selectedColor.toUpperCase()}</span></div><div className="dt-swatches">{detail.colors.map(c=><button key={c} aria-label={`Choose ${c}`} aria-pressed={selectedColor===c} onClick={()=>{if(c===selectedColor)return;setSelectedColor(c);setGalleryIndex(0);setZoomed(false)}} className={selectedColor===c?'picked':''}><span className={'dt-swatch dt-'+c.toLowerCase().replaceAll(' ','-')}/><span>{c}</span></button>)}</div><div className="dt-option-heading"><span className="option-label">SELECT SIZE</span><button className="dt-size-link" onClick={()=>setSizeGuide(v=>!v)} aria-expanded={sizeGuide}><Ruler size={15}/> SIZE GUIDE</button></div><div className="size-options">{detail.sizes.map(sz=><button aria-pressed={selectedSize===sz} className={selectedSize===sz?'selected':''} key={sz} onClick={()=>setSelectedSize(sz)}>{sz}</button>)}</div>{sizeGuide&&<div className="dt-guide"><strong>DRAGONTAIL SIZE REFERENCE</strong><p>Indicative body measurements in centimetres. Final garment measurements and fit guidance will be published with real inventory.</p><div className="dt-size-table"><span>SIZE</span><span>CHEST</span><span>WAIST</span>{[['XS','82–86','66–70'],['S','87–92','71–76'],['M','93–98','77–82'],['L','99–104','83–88'],['XL','105–110','89–94']].map(r=>r.map((v,i)=><span key={r[0]+i}>{v}</span>))}</div></div>}<p style={{fontSize:12,letterSpacing:1}}>{selectedSize&&selectedColor?`${detail.inventory?.find(x=>x.color===selectedColor&&x.size===selectedSize)?.quantity??0} IN STOCK — ${selectedColor} / ${selectedSize}`:"SELECT A VARIANT TO CHECK AVAILABILITY"}</p><div className="modal-actions"><button className="primary-btn" disabled={stockBusy || !selectedSize || !selectedColor || (detail.inventory?.find(x=>x.color===selectedColor&&x.size===selectedSize)?.quantity??0)===0} onClick={()=>addToBag(detail,selectedSize,selectedColor)}>{(detail.inventory?.find(x=>x.color===selectedColor&&x.size===selectedSize)?.quantity??0)===0?"OUT OF STOCK":"ADD TO BAG"} <ArrowRight size={18}/></button><button className={'wish-action '+(wishlist.includes(detail.id)?'active':'')} aria-label="Toggle wishlist" onClick={()=>toggleWish(detail.id)}><Heart fill={wishlist.includes(detail.id)?'currentColor':'none'}/></button></div><div className="details-note"><Check size={16}/> Selection saved in your bag on this device.</div><details className="dt-accordion"><summary>PRODUCT NOTES <Plus size={16}/></summary><p>{detail.description} Product photography and sizing are samples until the catalogue is finalized.</p></details><details className="dt-accordion"><summary>DELIVERY & RETURNS <Plus size={16}/></summary><p>Delivery charges, timelines and return policy will be confirmed before checkout is enabled. No orders can be placed yet.</p></details></div></section></div>}
 {toast&&<div role="status" className="toast">{toast}</div>}</>;
