function EmptyState({label,action}:{label:string;action:()=>void}){return <div className="empty-state"><ShoppingBag size={33} strokeWidth={1}/><p>{label}</p><button onClick={action}>EXPLORE THE COLLECTION <ArrowRight size={16}/></button></div>}
