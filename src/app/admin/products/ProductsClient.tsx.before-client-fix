import AdminSidebar from '@/components/AdminSidebar';
'use client';
import {useCallback,useEffect,useMemo,useState} from 'react';
import Link from 'next/link';
import {Package,ShoppingBag,LayoutDashboard,Users,BarChart3,Settings,ArrowUpRight,Menu,X,ChevronRight,Plus,Search,RefreshCw,Layers3} from 'lucide-react';
import AdminAvatar from '@/components/AdminAvatar';
import styles from '../orders/orders.module.css';
import './products.css';
type Variant={color:string;size:string;quantity:number};
type P={id?:number;name:string;category:string;type:string;price:number;image:string;altImage:string;tag:string;colors:string[];sizes:string[];description:string;active:boolean;inventory?:Variant[];colorImages?:Record<string,string[]>};
const blank=():P=>({name:'',category:'Women',type:'Essentials',price:0,image:'',altImage:'',tag:'',colors:['Black'],sizes:['S','M','L'],description:'',active:true,colorImages:{}});
const money=(n:number)=>'₹'+Number(n||0).toLocaleString('en-IN');
export default function AdminProducts(){
 const [overviewOpen,setOverviewOpen]=useState(true);
 const [uploading,setUploading]=useState('');
 const uploadImage=async(file:File,assign:(url:string)=>void,slot:string)=>{
  if(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>5*1024*1024){setError('Please choose a JPG, PNG or WebP up to 5 MB');return}
  setUploading(slot);setError('');
  try{const payload=new FormData();payload.append('image',file);const response=await fetch('/api/admin/media',{method:'POST',credentials:'same-origin',body:payload});const result=await response.json();if(!response.ok)throw new Error(result.error||'Upload failed');assign(result.url);setNotice('Image uploaded. Save the product to retain the image.')}catch(e){setError(e instanceof Error?e.message:'Upload failed')}finally{setUploading('')}
 };
 const mediaUpload=(slot:string,assign:(url:string)=>void)=><label className="dtMediaUpload">{uploading===slot?'Uploading…':'Upload / replace image'}<input type="file" accept="image/jpeg,image/png,image/webp" disabled={!!uploading} onChange={e=>{const selected=e.target.files?.[0];if(selected)void uploadImage(selected,assign,slot);e.currentTarget.value='';}}/></label>;
 useEffect(()=>{const toggle=(e:Event)=>{const opened=e.target;if(!(opened instanceof HTMLDetailsElement)||!opened.open)return;document.querySelectorAll('details.dtCompactFilters, details.dtActionMenu').forEach(el=>{if(el!==opened)(el as HTMLDetailsElement).open=false})};const dismiss=(e:PointerEvent)=>{const target=e.target;if(!(target instanceof Node))return;if(!(target instanceof Element)||!target.closest('details.dtCompactFilters,details.dtActionMenu'))document.querySelectorAll('details.dtCompactFilters,details.dtActionMenu').forEach(el=>(el as HTMLDetailsElement).open=false)};const escape=(e:KeyboardEvent)=>{if(e.key==='Escape')document.querySelectorAll('details.dtCompactFilters,details.dtActionMenu').forEach(el=>(el as HTMLDetailsElement).open=false)};document.addEventListener('toggle',toggle,true);document.addEventListener('pointerdown',dismiss,true);document.addEventListener('keydown',escape);return()=>{document.removeEventListener('toggle',toggle,true);document.removeEventListener('pointerdown',dismiss,true);document.removeEventListener('keydown',escape)}} ,[]);

 const [products,setProducts]=useState<P[]>([]),[loading,setLoading]=useState(true),[busy,setBusy]=useState(false),[unauth,setUnauth]=useState(false),[error,setError]=useState(''),[notice,setNotice]=useState(''),[search,setSearch]=useState(''),[form,setForm]=useState<P>(blank),[editor,setEditor]=useState(false),[stock,setStock]=useState<P|null>(null),[rows,setRows]=useState<Variant[]>([]),[mobile,setMobile]=useState(false),[stockColor,setStockColor]=useState('');
 const load=useCallback(async()=>{setLoading(true);try{const r=await fetch('/api/admin/products',{credentials:'same-origin',cache:'no-store'});if(r.status===401){setUnauth(true);setProducts([]);return}if(!r.ok)throw new Error('Unable to load products');const json=await r.json();setProducts(json.products||[]);setUnauth(false);setError('')}catch(e){setError(e instanceof Error?e.message:'Unable to load products')}finally{setLoading(false)}},[]);
 useEffect(()=>{void load()},[load]);
 const [categoryFilter,setCategoryFilter]=useState('All');
 const [visibilityFilter,setVisibilityFilter]=useState('All');
 const [stockFilter,setStockFilter]=useState('All');
 const shown=useMemo(()=>products.filter(p=>{
  const q=search.trim().toLowerCase();
  const matchesSearch=[p.name,p.type,p.category,String(p.id)].some(v=>v.toLowerCase().includes(q));
  const units=(p.inventory||[]).reduce((total,line)=>total+Number(line.quantity||0),0);
  return matchesSearch && (categoryFilter==='All'||p.category===categoryFilter)
   && (visibilityFilter==='All'||(visibilityFilter==='Published'?p.active:!p.active))
   && (stockFilter==='All'||(stockFilter==='In stock'?units>0:stockFilter==='Out of stock'?units===0:units>0&&units<=5));
 }),[products,search,categoryFilter,visibilityFilter,stockFilter]);
 const save=async(e:React.FormEvent)=>{e.preventDefault();setBusy(true);setError('');try{const r=await fetch('/api/admin/products',{method:form.id?'PUT':'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({...form,colors:form.colors.map(c=>c.trim()),colorImages:Object.fromEntries(form.colors.map(c=>[c.trim(),(form.colorImages?.[c]||[]).map(u=>u.trim()).filter(Boolean)]))})});const j=await r.json();if(!r.ok)throw new Error(j.error||'Save failed');setNotice(form.id?'Product updated':'Product created. Set inventory before taking orders.');setEditor(false);setForm(blank());await load()}catch(e){setError(e instanceof Error?e.message:'Save failed')}finally{setBusy(false)}};
 const edit=(p:P)=>{setStock(null);setForm({...p,colorImages:p.colorImages||{}});setEditor(true)};
 const changeVisibility=async(p:P)=>{setBusy(true);try{const r=await fetch('/api/admin/products',{method:'PUT',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({...p,active:!p.active})});if(!r.ok)throw new Error('Could not update visibility');await load()}catch(e){setError(e instanceof Error?e.message:'Could not update visibility')}finally{setBusy(false)}};
 const archiveProduct=async(p:P)=>{if(!p.id||busy)return;const typed=window.prompt(`To remove “${p.name}” from the catalog, type DELETE.\nThis is a recoverable archive; historical order data is kept.`);if(typed!=='DELETE')return;setBusy(true);setError('');try{const r=await fetch('/api/admin/products',{method:'DELETE',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:p.id,confirm:'DELETE'})});const result=await r.json();if(!r.ok)throw new Error(result.error||'Could not delete product');setNotice('Product archived and removed from active catalog. Historical orders are preserved.');await load()}catch(e){setError(e instanceof Error?e.message:'Could not delete product')}finally{setBusy(false)}};
 const stockOpen=(p:P)=>{setEditor(false);setStock(p);setStockColor(p.colors[0]||'');setRows(p.colors.flatMap(color=>p.sizes.map(size=>({color,size,quantity:p.inventory?.find(i=>i.color===color&&i.size===size)?.quantity??0}))))};
 const setQuantity=(color:string,size:string,quantity:number)=>setRows(previous=>previous.map(row=>row.color===color&&row.size===size?{...row,quantity:Math.max(0,Math.min(999999,Math.trunc(quantity)||0))}:row));
 const saveStock=async()=>{if(!stock?.id)return;setBusy(true);try{const r=await fetch('/api/admin/inventory',{method:'PUT',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId:stock.id,variants:rows})});const j=await r.json();if(!r.ok)throw new Error(j.error||'Stock update failed');setStock(null);setNotice('Stock updated');await load()}catch(e){setError(e instanceof Error?e.message:'Stock update failed')}finally{setBusy(false)}};
 const f=(k:keyof P,label:string,type='text',required=false)=><label>{label}<input required={required} type={type} min={type==='number'?0:undefined} value={String(form[k]??'')} onChange={e=>setForm(v=>({...v,[k]:type==='number'?Number(e.target.value):e.target.value}))}/></label>;
 return <div className={styles.shell}>
  <AdminSidebar active="products" mobile={mobile} onClose={()=>setMobile(false)} count={products.length}/>
  {mobile&&<button className={styles.menuBackdrop} onClick={()=>setMobile(false)} aria-label="Close navigation"/>}
  <main className={styles.main}><header className={styles.topbar}><button className={styles.mobileToggle} onClick={()=>setMobile(true)} aria-label="Open navigation"><Menu size={21}/></button><div className={styles.breadcrumb}>ADMIN <ChevronRight size={14}/><strong>PRODUCTS</strong></div><div className={styles.topRight}><AdminAvatar/></div></header>
   <div className={styles.content}><div className={styles.pageHeading}><div><p className={styles.eyebrow}>STORE OPERATIONS</p><h1>Products</h1><p className={styles.subhead}>Manage products, visibility, prices and inventory.</p></div><div className={styles.actions}><button className={styles.secondaryButton} onClick={()=>void load()}><RefreshCw size={15}/>Refresh</button><button className="dtPrimary" onClick={()=>{setForm(blank());setEditor(true);setStock(null)}}><Plus size={17}/>Add product</button></div></div>
   {notice&&<p className="dtMessage" role="status">{notice}</p>}{error&&<p className="dtError" role="alert">{error}</p>}
   {unauth?<div className="dtPanel"><h2>Admin sign in required</h2><Link href="/admin">Sign in to manage products →</Link></div>:<><section className={styles.metrics}><div><span>PRODUCTS</span><strong>{products.length}</strong><small>All catalog entries</small></div><div><span>PUBLISHED</span><strong>{products.filter(p=>p.active).length}</strong><small>Visible on store</small></div><div><span>HIDDEN</span><strong>{products.filter(p=>!p.active).length}</strong><small>Not published</small></div><div><span>STOCK UNITS</span><strong>{products.reduce((s,p)=>s+(p.inventory||[]).reduce((n,i)=>n+Number(i.quantity||0),0),0)}</strong><small>Tracked variants</small></div><div><span>OUT OF STOCK</span><strong>{products.filter(p=>p.active&&(p.inventory||[]).every(i=>i.quantity<=0)).length}</strong><small>Published products</small></div></section>
   <section className={styles.listCard}>
    <div className="dtCompactToolbar"><div className={styles.searchBox}><Search size={17}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search products..." aria-label="Search products"/></div><label className="dtCompactCategory"><span>Category</span><select aria-label="Product category" value={categoryFilter} onChange={e=>setCategoryFilter(e.target.value)}>{['All','Men','Women','Accessories'].map(c=><option key={c} value={c}>{c==='All'?'All categories':c}</option>)}</select></label><details className="dtCompactFilters"><summary>Filters {visibilityFilter!=='All'||stockFilter!=='All'?'●':''}</summary><div className="dtCompactFilterPopup"><label>Visibility<select value={visibilityFilter} onChange={e=>setVisibilityFilter(e.target.value)}><option>All</option><option>Published</option><option>Hidden</option></select></label><label>Inventory<select value={stockFilter} onChange={e=>setStockFilter(e.target.value)}><option>All</option><option>In stock</option><option>Low stock</option><option>Out of stock</option></select></label></div></details><span className="dtFilteredCount">{shown.length} of {products.length} products</span>{(categoryFilter!=='All'||visibilityFilter!=='All'||stockFilter!=='All'||search)&&<button className="dtClearFilters" onClick={()=>{setCategoryFilter('All');setVisibilityFilter('All');setStockFilter('All');setSearch('')}}>Clear</button>}</div><div className={styles.tableScroll}><table className={styles.table}><thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>PRICE</th><th>STOCK</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>{shown.map(p=><tr key={p.id}><td><div className="dtProdCell">{p.image&&<img src={p.image} alt=""/>}<div><strong>{p.name}</strong><small>{p.type}</small></div></div></td><td>{p.category}</td><td>{money(p.price)}</td><td>{(p.inventory||[]).reduce((n,i)=>n+Number(i.quantity||0),0)}</td><td><span className={`${styles.pill} ${p.active?styles.green:styles.grey}`}>{p.active?'Published':'Hidden'}</span></td><td><details className="dtActionMenu"><summary aria-label={`Actions for ${p.name}`} title="Product actions">•••</summary><div className="dtActionItems"><button onClick={e=>{e.currentTarget.closest("details")?.removeAttribute("open");edit(p)}}>✎ Edit product</button><button onClick={e=>{e.currentTarget.closest("details")?.removeAttribute("open");stockOpen(p)}}>▣ Manage stock</button><button disabled={busy} onClick={()=>void changeVisibility(p)}>{p.active?'◉ Hide product':'◉ Publish product'}</button><button className="dtDeleteAction" disabled={busy} onClick={()=>void archiveProduct(p)}>Delete product…</button></div></details></td></tr>)}</tbody></table>{!shown.length&&<div className={styles.empty}>No products found</div>}</div></section></>}
   </div>
  </main>
  {(editor||stock)&&<div className="dtOverlay" onMouseDown={()=>{setEditor(false);setStock(null)}}><aside className="dtDrawer" role="dialog" aria-modal="true" aria-label={stock?'Edit stock':'Product editor'} onMouseDown={e=>e.stopPropagation()}><header className="dtDrawerHead"><div><small>DRAGONTAIL / PRODUCTS</small><h2>{stock?'Manage stock':form.id?'Edit product':'Add a product'}</h2></div><button type="button" aria-label="Close" onClick={()=>{setEditor(false);setStock(null)}}><X/></button></header>{stock?<div className="dtForm dtStockForm"><div><p className="dtStockHelp">Choose a color to edit its size quantities. Changes are saved together when you select Save stock.</p><h3>{stock.name}</h3></div><div className="dtStockTotal"><span>TOTAL STOCK</span><strong>{rows.reduce((sum,row)=>sum+row.quantity,0)} units</strong></div><div className="dtStockColors" role="tablist" aria-label="Product color variants">{stock.colors.map(color=>{const quantity=rows.filter(row=>row.color===color).reduce((sum,row)=>sum+row.quantity,0);return <button type="button" role="tab" aria-selected={stockColor===color} className={'dtStockColor '+(stockColor===color?'dtStockColorActive':'')} key={color} onClick={()=>setStockColor(color)}><span className="dtStockColorName">{color}</span><span className="dtStockColorQty">{quantity} units</span></button>})}</div><section className="dtStockPanel" aria-label={stockColor+' stock'}><div className="dtStockPanelHead"><strong>{stockColor}</strong><span>{rows.filter(row=>row.color===stockColor).reduce((sum,row)=>sum+row.quantity,0)} available units</span></div>{rows.filter(row=>row.color===stockColor).map(row=><div className="dtStockSize" key={row.color+':'+row.size}><div><strong>Size {row.size}</strong><small>{row.quantity===0?'Out of stock':row.quantity+' in stock'}</small></div><div className="dtStockStep"><button type="button" aria-label={'Decrease '+row.color+' '+row.size} disabled={busy||row.quantity<=0} onClick={()=>setQuantity(row.color,row.size,row.quantity-1)}>−</button><input aria-label={'Stock quantity '+row.color+' '+row.size} type="number" min="0" max="999999" step="1" value={row.quantity} onChange={e=>setQuantity(row.color,row.size,Number(e.target.value))}/><button type="button" aria-label={'Increase '+row.color+' '+row.size} disabled={busy} onClick={()=>setQuantity(row.color,row.size,row.quantity+1)}>+</button></div></div>)}</section><button className="dtPrimary dtStockSave" disabled={busy} onClick={()=>void saveStock()}>{busy?'Saving...':'Save stock'}</button></div>:<form onSubmit={save} className="dtForm">{f('name','PRODUCT NAME','text',true)}<label>CATEGORY<select value={form.category} onChange={e=>setForm(v=>({...v,category:e.target.value}))}>{['Women','Men','Accessories'].map(c=><option key={c}>{c}</option>)}</select></label>{f('type','PRODUCT TYPE','text',true)}{f('price','PRICE (₹)','number',true)}{f('image','MAIN IMAGE HTTPS URL','url',true)}{mediaUpload('main',url=>setForm(v=>({...v,image:url})))}{f('altImage','SECOND IMAGE HTTPS URL','url',true)}{mediaUpload('second',url=>setForm(v=>({...v,altImage:url})))}<section className="dtVariantSection"><div className="dtVariantTop"><strong>COLOR VARIANTS</strong><p>Each color has its own front and back photos. Adding a color keeps existing variants unchanged.</p></div>{form.colors.map((color,index)=><div className="dtVariantCard" key={index}><div className="dtVariantHeading"><strong>Variant {index+1} — {color}</strong><button type="button" disabled={form.colors.length===1} onClick={()=>setForm(v=>{const colors=v.colors.filter((_,i)=>i!==index);const images={...v.colorImages};delete images[color];return {...v,colors,colorImages:images}})}>Remove</button></div><label>COLOR NAME<input value={color} onChange={e=>{const next=e.target.value;setForm(v=>{const colors=[...v.colors];colors[index]=next;const images={...v.colorImages};if(next!==color){images[next]=images[color]||[];delete images[color]}return {...v,colors,colorImages:images}})}}/></label><label>FRONT IMAGE HTTPS URL<input type="url" placeholder="https://.../front.jpg" value={form.colorImages?.[color]?.[0]||''} onChange={e=>setForm(v=>{const arr=[...(v.colorImages?.[color]||[])];arr[0]=e.target.value;return {...v,colorImages:{...v.colorImages,[color]:arr}}})}/></label>{mediaUpload('front-'+index,url=>setForm(v=>{const arr=[...(v.colorImages?.[color]||[])];arr[0]=url;return {...v,colorImages:{...v.colorImages,[color]:arr}}}))}<label>BACK IMAGE HTTPS URL<input type="url" placeholder="https://.../back.jpg" value={form.colorImages?.[color]?.[1]||''} onChange={e=>setForm(v=>{const arr=[...(v.colorImages?.[color]||[])];arr[1]=e.target.value;return {...v,colorImages:{...v.colorImages,[color]:arr}}})}/></label>{mediaUpload('back-'+index,url=>setForm(v=>{const arr=[...(v.colorImages?.[color]||[])];arr[1]=url;return {...v,colorImages:{...v.colorImages,[color]:arr}}}))}<p className="dtVariantHint">Size quantities: save this product, then use Stock to set quantities for {color}.</p></div>)}<button type="button" className="dtAddVariant" disabled={form.colors.length>=12} onClick={()=>setForm(v=>{let label='New color';let n=2;while(v.colors.includes(label)){label='New color '+n++;}return {...v,colors:[...v.colors,label],colorImages:{...v.colorImages,[label]:[]}}})}>+ Add color variant</button></section>{f('tag','TAG')}{f('description','DESCRIPTION')}<label>SIZES, COMMA SEPARATED<input value={form.sizes.join(', ')} onChange={e=>setForm(v=>({...v,sizes:e.target.value.split(',').map(x=>x.trim()).filter(Boolean)}))}/></label><label className="dtCheckbox"><input type="checkbox" checked={form.active} onChange={e=>setForm(v=>({...v,active:e.target.checked}))}/>Publish on storefront</label><button className="dtPrimary" type="submit" disabled={busy}>{busy?'Saving...':form.id?'Save product':'Create product'}</button></form>}</aside></div>}
 </div>;
}
