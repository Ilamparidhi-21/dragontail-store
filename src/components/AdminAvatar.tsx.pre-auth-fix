'use client';
import {useState} from 'react';
import {UserRound,LogOut,X} from 'lucide-react';
import {useRouter} from 'next/navigation';
export default function AdminAvatar(){const [open,setOpen]=useState(false),[busy,setBusy]=useState(false);const router=useRouter();async function logout(){setBusy(true);try{const r=await fetch('/api/admin/logout',{method:'POST',credentials:'same-origin'});if(!r.ok)throw new Error('Unable to sign out');router.replace('/admin');router.refresh()}catch{alert('Sign out failed. Please retry.')}finally{setBusy(false)}}return <><button type="button" onClick={()=>setOpen(true)} aria-label="Admin account" style={{width:35,height:35,borderRadius:'50%',border:0,background:'#202020',color:'#fff',fontWeight:700,cursor:'pointer'}}>D</button>{open&&<div onMouseDown={()=>setOpen(false)} style={{position:'fixed',inset:0,zIndex:900,background:'#0007',display:'flex',justifyContent:'flex-end'}}><aside role="dialog" aria-modal="true" aria-label="Administrator account" onMouseDown={e=>e.stopPropagation()} style={{width:'min(370px,100vw)',background:'#fff',padding:28,boxShadow:'-8px 0 28px #0002',color:'#222'}}><div style={{display:'flex',justifyContent:'space-between',alignItems:'center',borderBottom:'1px solid #e5e5e5',paddingBottom:20}}><strong>DRAGONTAIL / ADMIN</strong><button onClick={()=>setOpen(false)} aria-label="Close account menu" style={{background:'none',border:0,cursor:'pointer'}}><X/></button></div><div style={{padding:'38px 0 30px',display:'flex',gap:13,alignItems:'center'}}><UserRound size={28}/><div><strong>Administrator</strong><div style={{fontSize:12,color:'#777',marginTop:5}}>Store management access</div></div></div><button onClick={logout} disabled={busy} style={{width:'100%',padding:15,background:'#151515',color:'white',border:0,cursor:'pointer',display:'flex',gap:12,alignItems:'center',justifyContent:'center'}}><LogOut size={17}/>{busy?'SIGNING OUT...':'SIGN OUT'}</button></aside></div>}</>}
